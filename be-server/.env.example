# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/LMS?appName=Cluster0

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# ── Email OTP (Gmail App Password, bukan kata sandi akun) ────────────────────
SMTP_USER=your_gmail_address_here
SMTP_PASS=your_gmail_app_password_here

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── Midtrans ─────────────────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# ── Agora RTC — live session bootcamp ────────────────────────────────────────
# Daftar di console.agora.io; tidak perlu memasukkan data pembayaran
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
# Rem kuota sendiri; sisakan jarak dari kuota gratis Agora 10.000 menit/bulan
AGORA_MONTHLY_MINUTE_BUDGET=8000
